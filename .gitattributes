# Normalise line endings to LF in the repo; Windows checkouts get LF too, so files
# match what CI, WSL, Docker and the macOS runners see.
* text=auto eol=lf

# Windows scripts that need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats: no line-ending conversion, no text diffs
*.bin binary
*.heic binary
*.heif binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ply binary
*.pbf binary
*.onnx binary
*.onnx.data binary
*.mlmodel binary
*.mlpackage/** binary
*.mlmodelc/** binary
*.tar binary
*.tgz binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Collapsed in GitHub PR views, but keep local diffs readable: lockfile changes are
# supply-chain changes and get reviewed.
pnpm-lock.yaml linguist-generated=true

# Generated from the JSON Schemas by `pnpm gen` (packages/contracts/scripts/gen.ts): collapsed
# in GitHub PR views; CI regenerates them and fails on a diff.
packages/contracts/src/generated/** linguist-generated=true
packages/contracts/generated/** linguist-generated=true

# Generated from the migrations by `pnpm db dump` (db/scripts/dump.ts): collapsed in GitHub PR
# views, since the migration shows the change; CI regenerates it and fails on a diff.
db/schema.sql linguist-generated=true
