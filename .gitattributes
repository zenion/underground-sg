# Normalise line endings to LF in the repo; Windows checkouts get LF too, so files
# match what CI, WSL, Docker and the macOS runners see.
* text=auto eol=lf

# Windows scripts that need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats: no line-ending conversion, no text diffs
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ply binary
*.pbf binary
*.onnx binary
*.mlmodel binary
*.tar binary
*.tgz binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

pnpm-lock.yaml linguist-generated=true -diff
