{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/map-style/src/**",
        "$TURBO_ROOT$/packages/floorplan/src/**"
      ],
      "env": ["EXPO_PUBLIC_*"]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/map-style/src/**",
        "$TURBO_ROOT$/packages/floorplan/src/**",
        "$TURBO_ROOT$/db/seed/**",
        "$TURBO_ROOT$/db/src/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/contracts/schemas/**",
        "$TURBO_ROOT$/db/seed/**",
        "$TURBO_ROOT$/packages/map-style/src/**",
        "$TURBO_ROOT$/packages/floorplan/src/**",
        "$TURBO_ROOT$/services/api/test/fixtures/snapshot/**",
        "$TURBO_ROOT$/.github/workflows/walk-build.yml",
        "$TURBO_ROOT$/.github/workflows/ci.yml"
      ]
    }
  }
}
