{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "USG_RECORDER": "1",
        "USG_BUILD_PROFILE": "development"
      }
    },
    "walk": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false
      },
      "env": {
        "USG_RECORDER": "1",
        "USG_BUILD_PROFILE": "walk"
      }
    }
  }
}
