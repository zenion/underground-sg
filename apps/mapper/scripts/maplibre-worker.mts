// Writes src/map/generated/maplibre-worker.ts: MapLibre GL JS's worker script as a string.
//
//   node scripts/maplibre-worker.mts
//
// maplibre-gl v6 finds its worker (dist/maplibre-gl-worker.mjs) next to its own module through
// import.meta.url, which means nothing once Metro has bundled the map into a DOM component. The
// map component turns this string into a blob: URL and passes it to setWorkerUrl() instead, which
// works the same over Metro on the LAN, through a tunnel, in desktop Chrome and from file:// in a
// release build. The output is git-ignored and rewritten only when the installed version changes,
// so Metro doesn't reload for nothing. `start`, `web`, `build` and `typecheck` run this first.

import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const require = createRequire(import.meta.url);
const packageJson = require.resolve("maplibre-gl/package.json");
const { version } = JSON.parse(readFileSync(packageJson, "utf8")) as { version: string };
const source = readFileSync(join(dirname(packageJson), "dist", "maplibre-gl-worker.mjs"), "utf8");

const target = join(
  dirname(fileURLToPath(import.meta.url)),
  "..",
  "src",
  "map",
  "generated",
  "maplibre-worker.ts",
);
const output = [
  `// Generated by scripts/maplibre-worker.mts from maplibre-gl@${version}/dist/maplibre-gl-worker.mjs.`,
  "// Do not edit; this file is git-ignored and rewritten when maplibre-gl changes.",
  "",
  `export const MAPLIBRE_WORKER_VERSION = ${JSON.stringify(version)};`,
  "",
  `export const MAPLIBRE_WORKER_SOURCE: string = ${JSON.stringify(source)};`,
  "",
].join("\n");

let current = "";
try {
  current = readFileSync(target, "utf8");
} catch {
  // Not generated yet.
}
if (current !== output) {
  mkdirSync(dirname(target), { recursive: true });
  writeFileSync(target, output);
  console.log(`maplibre-worker: wrote the maplibre-gl ${version} worker (${source.length} chars)`);
}
