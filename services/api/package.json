{
  "name": "@usg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Underground SG API (Fastify 5 on Node): health, map metadata and the local stand-in for the public files; the publish transaction (gates, diff apply, snapshot, export, latest.json) as a CLI, and the local demo",
  "exports": {
    "./test/fixtures/*": "./test/fixtures/*"
  },
  "scripts": {
    "start": "node src/server.ts",
    "map": "node src/cli/map.ts",
    "demo": "node src/demo/cli.ts",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project stack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@fastify/cors": "11.3.1",
    "@fastify/swagger": "9.9.2",
    "@usg/contracts": "workspace:*",
    "@usg/db": "workspace:*",
    "@usg/map-style": "workspace:*",
    "@usg/scripts": "workspace:*",
    "fastify": "5.12.7",
    "kysely": "0.29.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
