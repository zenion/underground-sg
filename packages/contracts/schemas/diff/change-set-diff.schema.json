{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underground-sg.local/schemas/diff/change-set-diff.schema.json",
  "title": "ChangeSetDiff",
  "description": "change_sets.diff (docs/diff-format.md): a structural change set's changes to HEAD, one entry per touched row, at most 10000. A status change set's diff is empty. Private: diffs are never published. Geometry is GeoJSON in WGS84. Checked by the validator, not by this schema: at most one entry per feature_type and id, a modify changes something, no add or modify references a row the same diff removes, the rules the database also enforces (from_node differs from to_node, stairs and escalators are never step_free, a street prior has its source and sigma), and the coordinate rules of map/defs.schema.json.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/entry"
  },
  "maxItems": 10000,
  "$defs": {
    "entry": {
      "title": "DiffEntry",
      "description": "One change to one HEAD row. Venues and levels can only be modified: the owner's seed script adds and removes them.",
      "oneOf": [
        {
          "$ref": "#/$defs/venueModify"
        },
        {
          "$ref": "#/$defs/levelModify"
        },
        {
          "$ref": "#/$defs/spaceAdd"
        },
        {
          "$ref": "#/$defs/spaceModify"
        },
        {
          "$ref": "#/$defs/spaceRemove"
        },
        {
          "$ref": "#/$defs/nodeAdd"
        },
        {
          "$ref": "#/$defs/nodeModify"
        },
        {
          "$ref": "#/$defs/nodeRemove"
        },
        {
          "$ref": "#/$defs/edgeAdd"
        },
        {
          "$ref": "#/$defs/edgeModify"
        },
        {
          "$ref": "#/$defs/edgeRemove"
        },
        {
          "$ref": "#/$defs/poiAdd"
        },
        {
          "$ref": "#/$defs/poiModify"
        },
        {
          "$ref": "#/$defs/poiRemove"
        },
        {
          "$ref": "#/$defs/anchorAdd"
        },
        {
          "$ref": "#/$defs/anchorModify"
        },
        {
          "$ref": "#/$defs/anchorRemove"
        }
      ]
    },
    "venueModify": {
      "title": "VenueModify",
      "description": "An entry that changes an existing feature in venues.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "modify"
        },
        "feature_type": {
          "type": "string",
          "const": "venue"
        },
        "id": {
          "description": "The row's id (venues.id).",
          "allOf": [
            {
              "$ref": "../map/defs.schema.json#/$defs/uuid"
            }
          ]
        },
        "base_rev": {
          "description": "The row's rev when the diff was made. Approval refuses the change set (needs_rebase) if HEAD's rev differs.",
          "type": "integer",
          "minimum": 1
        },
        "before": {
          "description": "The row as it was when the diff was made.",
          "allOf": [
            {
              "$ref": "#/$defs/venueRow"
            }
          ]
        },
        "after": {
          "description": "The row as the change set leaves it.",
          "allOf": [
            {
              "$ref": "#/$defs/venueRow"
            }
          ]
        }
      },
      "required": ["op", "feature_type", "id", "base_rev", "before", "after"],
      "additionalProperties": false
    },
