    "venueRow": {
      "title": "VenueRow",
      "description": "The diffable columns of a venues row. permission is not one: only the owner's seed script writes it.",
      "type": "object",
      "properties": {
        "name": {
          "description": "venues.name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "$ref": "../map/defs.schema.json#/$defs/venueKind"
        },
        "operator": {
          "description": "venues.operator: the landlord or station operator, or null.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "footprint": {
          "description": "venues.footprint, or null.",
          "anyOf": [
            {
              "$ref": "../map/defs.schema.json#/$defs/multiPolygon"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["name", "kind", "operator", "footprint"],
      "additionalProperties": false
    },
