{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underground-sg.local/schemas/recording/recording.schema.json",
  "title": "RecordingManifest",
  "description": "recording.json of a session recording, recording_version 1 (docs/session-recording.md): written by the Swift recorder when the recording opens and rewritten when it closes. Until it closes, window.end_t, window.ended and rates are null, closed is false and files is empty. Unknown fields are rejected; adding one is a recording_version bump. Checked by validate-recording, not by this schema: files lists every other file exactly once with matching bytes and SHA-256, window.end_t is not before window.start_t, each segment's end_t is not before its start_t, and build.profile is synthetic exactly when origin is.",
  "type": "object",
  "properties": {
    "recording_version": {
      "description": "Version of the session recording format.",
      "type": "integer",
      "const": 1
    },
    "recording_id": {
      "description": "The ARKit session's UUID, generated on the phone; names the directory rec-<recording_id>/.",
      "allOf": [
        {
          "$ref": "../capture-bundle/defs.schema.json#/$defs/uuid"
        }
      ]
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "profile": {
      "$ref": "defs.schema.json#/$defs/profile"
    },
    "rates": {
      "description": "What the recording achieved over its window, or null until it closes.",
      "anyOf": [
        {
          "$ref": "#/$defs/rates"
        },
        {
          "type": "null"
        }
      ]
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "device_model": {
      "description": "Hardware identifier of the phone, as in the bundle manifest.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "os_version": {
      "description": "Operating system and version, as in the bundle manifest.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "session_started_at": {
      "description": "Wall-clock time at t = 0.",
      "allOf": [
        {
          "$ref": "../capture-bundle/defs.schema.json#/$defs/dateTime"
        }
      ]
    },
    "clocks": {
      "$ref": "#/$defs/clocks"
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "arkit": {
      "$ref": "#/$defs/arkit"
    },
    "detector_versions": {
      "description": "As the bundle manifest's privacy.detector_versions; null in lean, which runs no detectors.",
      "anyOf": [
        {
          "$ref": "../capture-bundle/manifest.schema.json#/$defs/detectorVersions"
        },
        {
          "type": "null"
        }
      ]
    },
    "venues": {
      "description": "Ids of the seeded venues walked, chosen before the start, so a recording can be found and deleted on request.",
      "type": "array",
      "items": {
        "$ref": "../capture-bundle/defs.schema.json#/$defs/uuid"
      },
      "maxItems": 50
    },
    "segments": {
      "description": "One per bundle the session wrote, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "maxItems": 200
    },
    "closed": {
      "description": "true once the recorder closed the recording cleanly; a recording left false was cut off.",
      "type": "boolean"
    },
    "files": {
      "description": "Every other file in the recording. At most 60000, DEFAULT_RECORDING_LIMITS.maxEntries.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "maxItems": 60000
    }
  },
  "required": [
    "recording_version",
    "recording_id",
    "origin",
    "profile",
    "rates",
    "build",
    "device_model",
    "os_version",
    "session_started_at",
    "clocks",
    "window",
    "arkit",
    "detector_versions",
    "venues",
    "segments",
    "closed",
    "files"
  ],
  "additionalProperties": false,
  "$defs": {
    "origin": {
      "title": "RecordingOrigin",
      "description": "device: recorded on a phone. synthetic: generated by pnpm rec synth. Only synthetic recordings may be in git.",
      "type": "string",
      "enum": ["device", "synthetic"]
    },
    "rates": {
      "title": "RecordingRates",
      "description": "Rates achieved over the recording's window.",
      "type": "object",
      "properties": {
        "frames_hz": {
          "description": "ARFrames a second.",
          "type": "number",
          "minimum": 0
        },
        "candidates_hz": {
          "description": "Candidates a second.",
          "type": "number",
          "minimum": 0
        },
        "imu_hz": {
          "description": "IMU samples a second.",
          "type": "number",
          "minimum": 0
        },
        "motion_hz": {
          "description": "Device-motion samples a second.",
          "type": "number",
          "minimum": 0
        },
        "mesh_interval_s": {
          "description": "Mean seconds between mesh snapshots, or null without two of them.",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["frames_hz", "candidates_hz", "imu_hz", "motion_hz", "mesh_interval_s"],
      "additionalProperties": false
    },
    "build": {
      "title": "RecordingBuild",
      "description": "The app build that recorded.",
      "type": "object",
      "properties": {
        "app_version": {
          "description": "Mapper app version, for example 0.1.0.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "git_commit": {
          "description": "The commit built, as 40 lowercase hex digits, or null when unknown.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "eas_build_id": {
          "description": "The EAS build's id, or null for a build made elsewhere.",
          "anyOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "$ref": "#/$defs/buildProfile"
        }
      },
      "required": ["app_version", "git_commit", "eas_build_id", "profile"],
      "additionalProperties": false
    },
    "buildProfile": {
      "title": "RecordingBuildProfile",
      "description": "walk: the walk build, the only build that records. synthetic: a set pnpm rec synth generated.",
      "type": "string",
      "enum": ["walk", "synthetic"]
    },
    "clocks": {
      "title": "RecordingClocks",
      "description": "The phone's clocks, read together at session start, to relate t to them.",
      "type": "object",
      "properties": {
        "system_uptime_s": {
          "description": "ProcessInfo.systemUptime, in seconds.",
          "type": "number",
          "minimum": 0
        },
        "media_time_s": {
          "description": "CACurrentMediaTime(), in seconds.",
          "type": "number",
          "minimum": 0
        },
        "wall_clock": {
          "description": "Date(), as wall-clock time.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/dateTime"
            }
          ]
        }
      },
      "required": ["system_uptime_s", "media_time_s", "wall_clock"],
      "additionalProperties": false
    },
    "window": {
      "title": "RecordingWindow",
      "description": "When the recording was open: from the first start-anchor mark until it closed. Nothing outside it is written.",
      "type": "object",
      "properties": {
        "start_t": {
          "description": "When the recording opened.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/sessionTime"
            }
          ]
        },
        "end_t": {
          "description": "When it closed, or null while it is open.",
          "anyOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/sessionTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended": {
          "description": "Why it closed, or null while it is open.",
          "anyOf": [
            {
              "$ref": "#/$defs/ended"
            },
            {
              "type": "null"
            }
          ]
        },
        "trimmed": {
          "description": "true when it was cut back to its last end anchor plus the margin.",
          "type": "boolean"
        }
      },
      "required": ["start_t", "end_t", "ended", "trimmed"],
      "additionalProperties": false
    },
    "ended": {
      "title": "RecordingEnded",
      "description": "Why a recording closed: end_anchor (End the session here), stop, idle (no movement for the idle timeout), background (the app left the foreground, a locked screen included), heat, disk, limit (a recording limit), or interrupted (cut off, found at the next launch).",
      "type": "string",
      "enum": ["end_anchor", "stop", "idle", "background", "heat", "disk", "limit", "interrupted"]
    },
    "arkit": {
      "title": "ArkitConfiguration",
      "description": "The ARWorldTrackingConfiguration the session ran.",
      "type": "object",
      "properties": {
        "scene_reconstruction": {
          "$ref": "#/$defs/sceneReconstruction"
        },
        "frame_semantics": {
          "description": "The frame semantics enabled.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameSemantic"
          },
          "maxItems": 32
        },
        "video_format": {
          "$ref": "#/$defs/videoFormat"
        },
        "world_alignment": {
          "$ref": "#/$defs/worldAlignment"
        }
      },
      "required": ["scene_reconstruction", "frame_semantics", "video_format", "world_alignment"],
      "additionalProperties": false
    },
    "sceneReconstruction": {
      "title": "SceneReconstruction",
      "description": "ARWorldTrackingConfiguration.sceneReconstruction.",
      "type": "string",
      "enum": ["meshWithClassification", "mesh", "none"]
    },
    "frameSemantic": {
      "title": "FrameSemantic",
      "description": "One of ARWorldTrackingConfiguration.frameSemantics.",
      "type": "string",
      "enum": ["sceneDepth", "smoothedSceneDepth"]
    },
    "worldAlignment": {
      "title": "WorldAlignment",
      "description": "ARWorldTrackingConfiguration.worldAlignment.",
      "type": "string",
      "enum": ["gravity", "gravityAndHeading", "camera"]
    },
    "videoFormat": {
      "title": "ArVideoFormat",
      "description": "The video format: the image size, in the sensor's native landscape orientation, that frames.jsonl's intrinsics refer to, and its frame rate.",
      "type": "object",
      "properties": {
        "width": {
          "description": "Width in pixels.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Height in pixels.",
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "description": "Frames a second.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["width", "height", "fps"],
      "additionalProperties": false
    },
    "segment": {
      "title": "RecordingSegment",
      "description": "One bundle the session wrote.",
      "type": "object",
      "properties": {
        "capture_id": {
          "description": "The bundle's capture_id.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/uuid"
            }
          ]
        },
        "manifest_sha256": {
          "description": "SHA-256 of the bundle's manifest.json bytes.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/sha256"
            }
          ]
        },
        "start_t": {
          "description": "When the segment started.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/sessionTime"
            }
          ]
        },
        "end_t": {
          "description": "When it ended.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/sessionTime"
            }
          ]
        },
        "frame_offset": {
          "description": "The session frame of the bundle's frame 0: a bundle's frame is the session frame minus this.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/frameIndex"
            }
          ]
        },
        "kept": {
          "description": "false for a discarded segment, whose bundle is gone.",
          "type": "boolean"
        }
      },
      "required": ["capture_id", "manifest_sha256", "start_t", "end_t", "frame_offset", "kept"],
      "additionalProperties": false
    },
    "file": {
      "title": "RecordingFile",
      "description": "One recording file, with its size and digest.",
      "type": "object",
      "properties": {
        "path": {
          "$ref": "defs.schema.json#/$defs/recordingPath"
        },
        "bytes": {
          "description": "File size in bytes.",
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "description": "SHA-256 of the file's bytes.",
          "allOf": [
            {
              "$ref": "../capture-bundle/defs.schema.json#/$defs/sha256"
            }
          ]
        }
      },
      "required": ["path", "bytes", "sha256"],
      "additionalProperties": false
    }
  }
}
