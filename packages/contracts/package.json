{
  "name": "@usg/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JSON Schema 2020-12 contracts for Underground SG file formats (capture bundle, public map files, change-set diff), with generated TypeScript and Swift types, the capture bundle validator and the map file validators",
  "exports": {
    ".": "./src/index.ts",
    "./bundle-validator": "./src/bundle-validator/index.ts",
    "./validators": "./src/validators.ts",
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "validate-bundle": "./src/bundle-validator/cli.ts"
  },
  "scripts": {
    "gen": "node scripts/gen.ts",
    "typecheck": "tsc && tsc -p tsconfig.neutral.json",
    "test": "vitest run",
    "validate-bundle": "node src/bundle-validator/cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "4.10.2",
    "json-schema-to-typescript": "16.0.0",
    "quicktype-core": "26.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
