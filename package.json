{
  "name": "underground-sg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "gen": "turbo run gen",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:venue": "turbo run test:venue",
    "build": "turbo run build",
    "mapper": "pnpm --filter @usg/mapper start --go",
    "dev:phone": "node scripts/dev-phone.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:db": "turbo run test:db",
    "migrate": "pnpm --filter @usg/db migrate",
    "db": "pnpm --filter @usg/db run",
    "buckets": "pnpm --filter @usg/scripts buckets",
    "api": "pnpm --filter @usg/api start",
    "map": "pnpm --filter @usg/api map",
    "demo": "pnpm --filter @usg/api demo",
    "web": "pnpm --filter @usg/web dev",
    "web:fixtures": "pnpm --filter @usg/web dev:fixtures"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7"
  }
}
