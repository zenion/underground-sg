{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/errors.ts"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docker-compose.yml",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/.github/workflows/ci.yml"
      ]
    }
  }
}
