# secrets
.env
.env.*
!.env.example

# signing and store credentials
credentials.json
*.p8
*.p12
*.mobileprovision

# capture data never goes in git. Anchored to the repo root, so hand-made fixtures
# named capture-<id>/ and Swift resource bundles elsewhere stay tracked.
/captures/
/capture-*/
/*.bundle/

# session recordings and their exports never go in git (docs/session-recording.md, ADR 0010).
# Unanchored, so a copy anywhere in the tree is ignored. Only the generated synthetic sets
# (`pnpm rec synth`, origin: synthetic; one directory per set, holding rec-<id>/ beside its
# capture-<id>/ bundles) are tracked, and CI and the pre-push hook check that they are synthetic.
# A set's own directory must not be named rec-* or replay-*, or nothing inside it can be re-included.
rec-*/
replay-*/
*.part
!packages/recording/fixtures/synthetic/**/rec-*/

# restricted_zones outlines (back-of-house areas) are private
db/private/

# local data volumes (Docker), and fixtures recorded in venues (.data/fixtures/)
.data/

# Node, pnpm, Turborepo, Vite
node_modules/
dist/
.turbo/
coverage/

# Expo: ios/ and android/ are generated (Continuous Native Generation).
# The Swift source in apps/mapper/modules/capture-native/ios/ is tracked.
.expo/
apps/mapper/ios/
apps/mapper/android/
# Written by Expo CLI, and the mapper's copy of the MapLibre worker (scripts/maplibre-worker.mts)
apps/mapper/expo-env.d.ts
apps/mapper/src/map/generated/
*.ipa
*.apk
*.aab

# Go (services/localization)
services/localization/bin/
*.test
coverage.out

# Python (offline tooling and containerised batch workers only)
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Xcode, and SwiftPM (apps/mapper/modules/capture-native)
DerivedData/
.build/
.swiftpm/
*.xcuserstate
xcuserdata/

# OS
.DS_Store
Thumbs.db
