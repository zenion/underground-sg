# Settings for the local stack (docker-compose.yml) and the workspace scripts. Copy this
# file to .env at the repo root; .env is git-ignored. The values below are safe defaults for
# a stack bound to 127.0.0.1: use them only locally, and keep real credentials (OneMap, R2,
# AWS) out of this file and out of git.
#
# Host ports stay below 49152. With WSL2 or Hyper-V running, Windows reserves blocks of its
# dynamic range (49152-65535) at boot, and a port inside one fails to bind;
# `netsh interface ipv4 show excludedportrange protocol=tcp` lists the reserved blocks.

# PostGIS. The port avoids clashing with another local Postgres on 5432. POSTGRES_USER and
# POSTGRES_PASSWORD take effect only when the postgis-data volume is first created: after
# changing them, run `docker compose down -v` (this deletes the data) or change the
# password with ALTER ROLE.
POSTGRES_USER=usg
POSTGRES_PASSWORD=usg-local-only
POSTGRES_PORT=25432

# The app database. `pnpm migrate` creates it on first run and applies db/migrations.
# Keep the user, password and port in step with the values above. The database rule tests
# (`pnpm test:db`) and `pnpm db dump` use the same server, in throwaway databases named
# usg_scratch_*; they never open this database.
DATABASE_URL=postgres://usg:usg-local-only@localhost:25432/usg?sslmode=disable

# RustFS, the local S3 stand-in: S3 API and web console ports.
RUSTFS_PORT=29000
RUSTFS_CONSOLE_PORT=29001

# S3 settings for the scripts. Locally, the key pair is RustFS's root user (it also signs in
# to the console). This pair is public, in git: before RustFS listens beyond 127.0.0.1
# (Phase 2 opens it to the LAN), replace it in .env with a generated one. Keep the
# endpoint's port in step with RUSTFS_PORT. RustFS accepts any region; AWS S3 (Phase 4)
# will use ap-southeast-1.
S3_ENDPOINT=http://localhost:29000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=usg-local
S3_SECRET_ACCESS_KEY=usg-local-only-secret

# Buckets, created by `pnpm buckets`. Private: raw capture bundles (S3 ap-southeast-1 from
# Phase 4).
S3_BUCKET_BUNDLES=usg-bundles
# Private: full exports of HEAD that rollback restores from (map_versions.private_export_uri).
S3_BUCKET_EXPORTS=usg-exports
# Public files: each version's indoor.json and street.json, plus latest.json and status.json
# (Cloudflare R2 in production). Only public, non-personal files go here.
S3_BUCKET_PUBLIC=usg-public

# The API (services/api), `pnpm --filter @usg/api start`. It listens on this machine only. Set
# API_HOST=0.0.0.0 only when the phone needs it over the LAN (the mapper app's dev build): every
# route is read-only, but anyone on the network can then read /health, /map/latest, /public and
# /glyphs, and Windows asks to let Node through its firewall. Keep the port below 49152.
API_HOST=127.0.0.1
API_PORT=28000
# Origins allowed to read the API from a browser or WebView (CORS), comma-separated: the Vite dev
# server (apps/web) and Metro, which serves the mapper app's DOM components. Add Metro's LAN
# address (http://<the PC's LAN IP>:8081) when the phone loads them.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Where clients fetch the public files from, as GET /map/latest gives them. Empty: this API's
# /public/, which serves the usg-public bucket. In production, the R2 bucket's public URL.
API_PUBLIC_FILES_URL=
